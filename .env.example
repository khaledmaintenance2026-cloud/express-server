# ============================================================================
# إعدادات نظام صيانتي — انسخ هذا الملف باسم .env وعدّل القيم حسب سيرفركم
#   (على PowerShell:  Copy-Item .env.example .env )
# ============================================================================

# ---- قاعدة البيانات PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sayanati_db
DB_USER=postgres
DB_PASSWORD=CHANGE_ME

# ---- مفتاح تشفير رموز الدخول (JWT) ----
# غيّروا هذه القيمة لأي نص عشوائي طويل قبل التشغيل الفعلي في الشركة
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ---- حسابات المدراء الابتدائية ----
# أي بريد إلكتروني هنا (مفصول بفاصلة) يُعتمد تلقائيًا كـ"مدير نظام" فور
# التسجيل، بدون انتظار موافقة أحد. استخدموها لإنشاء أول حساب مدير فقط.
SEED_ADMIN_EMAILS=admin@yourcompany.com

# ---- المنفذ (Port) الذي يعمل عليه السيرفر محليًا ----
PORT=3000
